set(MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "No install manifest found. Run 'cmake --install .' first.")
endif()
file(STRINGS "${MANIFEST}" files)
foreach(file ${files})
    if(EXISTS "${file}")
        message(STATUS "Removing: ${file}")
        file(REMOVE "${file}")
    endif()
endforeach()
